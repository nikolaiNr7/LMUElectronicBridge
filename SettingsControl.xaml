<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="LMUElectronicBridge.SettingsControl"
             d:DesignWidth="562.115">

    <ScrollViewer Background="#111111">
        <StackPanel Margin="15">

            <styles:SHSection Title="SYNC CONTROL" ShowSeparator="True">
                <StackPanel>
                    <Button Content="MANUAL SYNC FROM LMU" 
                            Click="SyncAll_Click" 
                            Height="40" 
                            Background="#00FF00" 
                            Foreground="Black" 
                            FontWeight="Bold" 
                            Margin="0,0,0,10"/>

                    <TextBlock Text="Steering Wheel Mapping:" Foreground="#888888" FontSize="10" Margin="0,5,0,2"/>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.SyncAllFromGame" FriendlyName="Sync Electronics from Game"/>

                    <TextBlock Text="Note: Values sync automatically when session resets or changes." 
                               Foreground="#666666" FontSize="9" FontStyle="Italic" Margin="0,5,0,0"/>
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="TRACTION CONTROL (MAIN)" ShowSeparator="True">
                <StackPanel>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.TC_MainIncrease" FriendlyName="TC Main +"/>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.TC_MainDecrease" FriendlyName="TC Main -"/>
                    <TextBlock Text="{Binding Settings.TC_Main, StringFormat=Synced Level: \{0\}}" 
                               FontSize="16" Foreground="#00FF00" FontWeight="Bold" Margin="0,5"/>
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="TC POWER CUT" ShowSeparator="True">
                <StackPanel>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.TC_CutIncrease" FriendlyName="TC Cut +"/>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.TC_CutDecrease" FriendlyName="TC Cut -"/>
                    <TextBlock Text="{Binding Settings.TC_Cut, StringFormat=Synced Level: \{0\}}" 
                               FontSize="16" Foreground="#00FF00" FontWeight="Bold" Margin="0,5"/>
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="TC SLIP ANGLE" ShowSeparator="True">
                <StackPanel>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.TC_SlipIncrease" FriendlyName="TC Slip +"/>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.TC_SlipDecrease" FriendlyName="TC Slip -"/>
                    <TextBlock Text="{Binding Settings.TC_Slip, StringFormat=Synced Level: \{0\}}" 
                               FontSize="16" Foreground="#00FF00" FontWeight="Bold" Margin="0,5"/>
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="ANTI-LOCK BRAKES (ABS)" ShowSeparator="True">
                <StackPanel>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.ABSIncrease" FriendlyName="ABS +"/>
                    <ui:ControlsEditor ActionName="LMUElectronicBridge.ABSDecrease" FriendlyName="ABS -"/>
                    <TextBlock Text="{Binding Settings.ABS, StringFormat=Synced Level: \{0\}}" 
                               FontSize="16" Foreground="#00FF00" FontWeight="Bold" Margin="0,5"/>
                </StackPanel>
            </styles:SHSection>

        </StackPanel>
    </ScrollViewer>
</UserControl>